+package web
+
+import (
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+
+	"github.com/alibaba/opensandbox/execd/pkg/flag"
+	"github.com/alibaba/opensandbox/execd/pkg/web/model"
+)
+
+func TestProxyKeepsParentTokenOnlyForTheExecdListener(test *testing.T) {
+	gin.SetMode(gin.TestMode)
+	originalPort := flag.ServerPort
+	defer func() { flag.ServerPort = originalPort }()
+	for _, returningToExecd := range []bool{false, true} {
+		received := make(chan string, 1)
+		upstream := httptest.NewServer(http.HandlerFunc(func(response http.ResponseWriter, request *http.Request) {
+			received <- request.Header.Get(model.ApiAccessTokenHeader)
+			response.WriteHeader(http.StatusNoContent)
+		}))
+		address := upstream.Listener.Addr().(*net.TCPAddr)
+		flag.ServerPort = 44772
+		if returningToExecd {
+			flag.ServerPort = address.Port
+		}
+		router := gin.New()
+		router.Use(accessTokenMiddleware("private-parent-token"), ProxyMiddleware())
+		proxyServer := httptest.NewServer(router)
+		defer proxyServer.Close()
+		request, failure := http.NewRequest(http.MethodGet, proxyServer.URL+"/proxy/"+strconv.Itoa(address.Port)+"/ping", nil)
+		require.NoError(test, failure)
+		request.Header.Set(model.ApiAccessTokenHeader, "private-parent-token")
+		response, failure := proxyServer.Client().Do(request)
+		require.NoError(test, failure)
+		response.Body.Close()
+		require.Equal(test, http.StatusNoContent, response.StatusCode)
+		if returningToExecd {
+			require.Equal(test, "private-parent-token", <-received)
+		} else {
+			require.Empty(test, <-received)
+		}
+		upstream.Close()
+	}
+}
