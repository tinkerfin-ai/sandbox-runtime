+func TestDeleteSessionPreservesSharedDirectoryBeforeProbeWrite(test *testing.T) {
+	synctest.Test(test, func(test *testing.T) {
+		runner := newTestRunner(test)
+		workspace := test.TempDir()
+		probeDir := filepath.Join(workspace, isolatedBackgroundRunDir)
+		if err := os.MkdirAll(probeDir, 0o700); err != nil {
+			test.Fatal(err)
+		}
+		first := newProbeTestSession(test, runner, "569d3f53-dd01-478c-8a1a-8bc457bbf37c", workspace)
+		second := newProbeTestSession(test, runner, "9e6a2e68-081f-4a53-ab11-ffac0b930e5e", workspace)
+		test.Cleanup(func() {
+			if err := runner.Close(); err != nil {
+				test.Error(err)
+			}
+		})
+		run := &IsolatedBackgroundRun{ID: "first-owned-run", SessionID: first.id}
+		runner.bgRuns.Store(run.ID, run)
+		if err := os.WriteFile(filepath.Join(workspace, run.relLogPath()), []byte("owned"), 0o600); err != nil {
+			test.Fatal(err)
+		}
+		directorySelected := make(chan struct{})
+		allowProbeWrite := make(chan struct{})
+		probeDone := make(chan error, 1)
+		writer := isolatedControlWriter(func(payload []byte) (int, error) {
+			probeName := regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+			close(directorySelected)
+			<-allowProbeWrite
+			if err := os.WriteFile(filepath.Join(probeDir, probeName), []byte("0"), 0o600); err != nil {
+				return 0, err
+			}
+			return len(payload), nil
+		})
+		go func() { probeDone <- submitTestProbe(runner, second, writer) }()
+		<-directorySelected
+		if err := runner.DeleteIsolatedSession(first.id); err != nil {
+			test.Error(err)
+		}
+		if _, err := os.Stat(probeDir); err != nil {
+			test.Errorf("another session's selected control directory disappeared: %v", err)
+		}
+		if _, err := os.Lstat(filepath.Join(workspace, run.relLogPath())); !os.IsNotExist(err) {
+			test.Errorf("owned background log remains after deletion: %v", err)
+		}
+		close(allowProbeWrite)
+		if err := <-probeDone; err != nil {
+			test.Errorf("another session's delayed probe write failed: %v", err)
+		}
+	})
+}
