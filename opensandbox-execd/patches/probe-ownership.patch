+func TestDeleteSessionPreservesUnownedProbeFiles(test *testing.T) {
+	runner := newTestRunner(test)
+	workspace := test.TempDir()
+	sessionID, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		WorkspacePath: workspace,
+		WorkspaceMode: "rw",
+	})
+	if err != nil {
+		test.Fatal(err)
+	}
+	test.Cleanup(func() {
+		if err := runner.Close(); err != nil {
+			test.Error(err)
+		}
+	})
+	view, err := runner.GetMergedView(sessionID)
+	if err != nil {
+		test.Fatal(err)
+	}
+	for _, relative := range []string{".probe-user-data", filepath.Join(isolatedBackgroundRunDir, ".probe-other-session")} {
+		if err := view.MkdirAll(filepath.Dir(relative), 0o700); err != nil {
+			test.Fatal(err)
+		}
+		if err := view.WriteFile(relative, []byte("keep"), 0o600); err != nil {
+			test.Fatal(err)
+		}
+	}
+	if err := runner.DeleteIsolatedSession(sessionID); err != nil {
+		test.Fatal(err)
+	}
+	sessionID, err = runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		WorkspacePath: workspace,
+		WorkspaceMode: "rw",
+	})
+	if err != nil {
+		test.Fatal(err)
+	}
+	view, err = runner.GetMergedView(sessionID)
+	if err != nil {
+		test.Fatal(err)
+	}
+	for _, relative := range []string{".probe-user-data", filepath.Join(isolatedBackgroundRunDir, ".probe-other-session")} {
+		contents, err := view.ReadFile(relative)
+		if err != nil || string(contents) != "keep" {
+			test.Errorf("unowned file %q changed: %q, %v", relative, contents, err)
+		}
+	}
+}
