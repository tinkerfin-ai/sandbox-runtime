+func TestBackgroundProbePendingCapacityAndFreshResult(test *testing.T) {
+	synctest.Test(test, func(test *testing.T) {
+		runner := newTestRunner(test)
+		workspace := test.TempDir()
+		session := newProbeTestSession(test, runner, "0d1a6f54-ce06-4d7c-9a96-1ce6c8c975f6", workspace)
+		test.Cleanup(func() {
+			if err := runner.Close(); err != nil {
+				test.Error(err)
+			}
+		})
+		firstProbe := queueTestProbe(test, runner, session)
+		if err := os.WriteFile(filepath.Join(workspace, firstProbe), nil, 0o600); err != nil {
+			test.Fatal(err)
+		}
+		writes := 0
+		writer := isolatedControlWriter(func(payload []byte) (int, error) {
+			writes++
+			probeName := regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+			if probeName == firstProbe {
+				test.Fatal("new preflight reused the unconfirmed probe identity")
+			}
+			if err := os.WriteFile(filepath.Join(workspace, probeName), []byte("1"), 0o600); err != nil {
+				return 0, err
+			}
+			return len(payload), nil
+		})
+		if err := submitTestProbe(runner, session, writer); err == nil {
+			test.Fatal("another probe was accepted while the prior probe was pending")
+		}
+		if writes != 0 || session.pendingBackgroundProbe != firstProbe {
+			test.Fatal("pending-probe capacity did not stay at one")
+		}
+		if err := os.WriteFile(filepath.Join(workspace, firstProbe), []byte("0"), 0o600); err != nil {
+			test.Fatal(err)
+		}
+		if err := submitTestProbe(runner, session, writer); err == nil {
+			test.Fatal("prior success was reused instead of the new probe's rejection")
+		}
+		if writes != 1 || session.pendingBackgroundProbe != "" {
+			test.Fatal("completed probes did not release their capacity")
+		}
+		if _, err := os.Lstat(filepath.Join(workspace, firstProbe)); !os.IsNotExist(err) {
+			test.Fatalf("completed old probe remains: %v", err)
+		}
+	})
+}
