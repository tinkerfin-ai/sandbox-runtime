+func TestDeleteSessionRetainsProbeUntilNamespaceDrains(test *testing.T) {
+	runner := newTestRunner(test)
+	workspace := test.TempDir()
+	session := newProbeTestSession(test, runner, "d8759d78-d6b1-4d85-8e9f-f46b9ac9042b", workspace)
+	probeName := queueTestProbe(test, runner, session)
+	lifecycle := newLifecycleHarness()
+	terminationErr := errors.New("namespace termination remains unconfirmed")
+	lifecycle.terminationErr = terminationErr
+	session.lifecycle = lifecycle
+	test.Cleanup(func() {
+		lifecycle.terminationErr = nil
+		if err := runner.Close(); err != nil {
+			test.Error(err)
+		}
+	})
+	if err := os.WriteFile(filepath.Join(workspace, probeName), []byte("0"), 0o600); err != nil {
+		test.Fatal(err)
+	}
+	if err := runner.DeleteIsolatedSession(session.id); !errors.Is(err, terminationErr) {
+		test.Fatalf("unconfirmed namespace termination error = %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(workspace, probeName)); err != nil {
+		test.Fatalf("unconfirmed namespace lost its probe: %v", err)
+	}
+	if runner.lookup(session.id) != session || session.pendingBackgroundProbe != probeName {
+		test.Fatal("unconfirmed namespace lost probe ownership")
+	}
+	lifecycle.terminationErr = nil
+	if err := runner.DeleteIsolatedSession(session.id); err != nil {
+		test.Fatal(err)
+	}
+	if _, err := os.Lstat(filepath.Join(workspace, probeName)); !os.IsNotExist(err) {
+		test.Fatalf("confirmed namespace retained its probe: %v", err)
+	}
+}
