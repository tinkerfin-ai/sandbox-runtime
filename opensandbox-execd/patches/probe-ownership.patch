+func newProbeTestSession(test *testing.T, runner *IsolatedRunner, sessionID, workspace string) *isolatedSession {
+	test.Helper()
+	session := &isolatedSession{
+		id: sessionID,
+		opts: &IsolatedSessionOptions{
+			WorkspacePath: workspace,
+			WorkspaceMode: "rw",
+		},
+		doneCh: make(chan struct{}),
+	}
+	openSessionView(test, session)
+	runner.ctrl.isolatedSessionMap.Store(session.id, session)
+	return session
+}
+
+func submitTestProbe(runner *IsolatedRunner, session *isolatedSession, writer io.Writer) error {
+	session.runMu.Lock()
+	defer session.runMu.Unlock()
+	if err := session.beginOperation(); err != nil {
+		return err
+	}
+	defer session.endOperation()
+	paths, err := session.backgroundRunPaths()
+	if err != nil {
+		return err
+	}
+	return runner.preflightBackgroundLogDir(session, writer, paths)
+}
+
+func queueTestProbe(test *testing.T, runner *IsolatedRunner, session *isolatedSession) string {
+	test.Helper()
+	probeName := ""
+	dispatchErr := errors.New("probe dispatch did not confirm completion")
+	writer := isolatedControlWriter(func(payload []byte) (int, error) {
+		probeName = regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+		if probeName == "" || session.pendingBackgroundProbe != probeName {
+			test.Fatal("probe was not registered before dispatch")
+		}
+		return len(payload), dispatchErr
+	})
+	if err := submitTestProbe(runner, session, writer); !errors.Is(err, dispatchErr) {
+		test.Fatalf("probe dispatch error = %v", err)
+	}
+	return probeName
+}
