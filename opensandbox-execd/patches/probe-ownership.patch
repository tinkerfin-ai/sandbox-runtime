+func TestBackgroundProbeUsesWritableFallbackWithOutsideControlSymlink(test *testing.T) {
+	runner := newTestRunner(test)
+	workspace := test.TempDir()
+	foreignFile := filepath.Join(test.TempDir(), "control-file")
+	if err := os.WriteFile(foreignFile, []byte("keep"), 0o600); err != nil {
+		test.Fatal(err)
+	}
+	if err := os.Symlink(foreignFile, filepath.Join(workspace, ".execd")); err != nil {
+		test.Fatal(err)
+	}
+	session := newProbeTestSession(test, runner, "fallback-session", workspace)
+	test.Cleanup(func() {
+		if err := runner.Close(); err != nil {
+			test.Error(err)
+		}
+	})
+	writer := isolatedControlWriter(func(payload []byte) (int, error) {
+		if err := exec.Command("sh", "-c", string(payload)).Run(); err != nil {
+			return 0, err
+		}
+		return len(payload), nil
+	})
+	if err := submitTestProbe(runner, session, writer); err != nil {
+		test.Fatalf("writable fallback rejected: %v", err)
+	}
+	if err := os.Remove(filepath.Join(workspace, ".execd")); err != nil {
+		test.Fatal(err)
+	}
+	if err := submitTestProbe(runner, session, writer); err != nil {
+		test.Fatalf("fresh probe after directory repair rejected: %v", err)
+	}
+	contents, err := os.ReadFile(foreignFile)
+	if err != nil || string(contents) != "keep" {
+		test.Fatalf("outside file changed: %q, %v", contents, err)
+	}
+}
