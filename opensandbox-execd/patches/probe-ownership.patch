+func TestBackgroundProbeRetainsLateWriteOwnership(test *testing.T) {
+	for _, termination := range []string{"timeout", "session stopped", "dispatch failed"} {
+		test.Run(termination, func(test *testing.T) {
+			synctest.Test(test, func(test *testing.T) {
+				runner := newTestRunner(test)
+				workspace := test.TempDir()
+				session := newProbeTestSession(test, runner, "b926219f-3e53-4e3f-a3ae-89bdbcb77325", workspace)
+				test.Cleanup(func() {
+					if err := runner.Close(); err != nil {
+						test.Error(err)
+					}
+				})
+				probeSent := make(chan string, 1)
+				probeDone := make(chan error, 1)
+				dispatchErr := errors.New("dispatch failed")
+				writer := isolatedControlWriter(func(payload []byte) (int, error) {
+					probeName := regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+					probeSent <- probeName
+					if termination == "dispatch failed" {
+						return len(payload), dispatchErr
+					}
+					return len(payload), nil
+				})
+				go func() { probeDone <- submitTestProbe(runner, session, writer) }()
+				probeName := <-probeSent
+				synctest.Wait()
+				if termination == "session stopped" {
+					close(session.doneCh)
+				}
+				if err := <-probeDone; err == nil {
+					test.Fatal("unconfirmed preflight succeeded")
+				} else if termination == "session stopped" && !errors.Is(err, ErrSessionNotActive) {
+					test.Fatalf("stopped preflight error = %v", err)
+				} else if termination == "dispatch failed" && !errors.Is(err, dispatchErr) {
+					test.Fatalf("dispatch error = %v", err)
+				}
+				if session.pendingBackgroundProbe != probeName {
+					test.Fatal("unconfirmed probe lost its cleanup ownership")
+				}
+				if err := os.WriteFile(filepath.Join(workspace, probeName), []byte("0"), 0o600); err != nil {
+					test.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(workspace, ".probe-user-data"), []byte("keep"), 0o600); err != nil {
+					test.Fatal(err)
+				}
+				if err := runner.DeleteIsolatedSession(session.id); err != nil {
+					test.Fatal(err)
+				}
+				if _, err := os.Lstat(filepath.Join(workspace, probeName)); !os.IsNotExist(err) {
+					test.Fatalf("late owned probe remains: %v", err)
+				}
+				contents, err := os.ReadFile(filepath.Join(workspace, ".probe-user-data"))
+				if err != nil || string(contents) != "keep" {
+					test.Fatalf("unowned probe changed: %q, %v", contents, err)
+				}
+			})
+		})
+	}
+}
