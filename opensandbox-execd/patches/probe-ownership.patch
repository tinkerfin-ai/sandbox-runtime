+func TestDeleteSessionPreservesAnotherSessionsPendingProbe(test *testing.T) {
+	for _, location := range []string{".", isolatedBackgroundRunDir} {
+		test.Run(location, func(test *testing.T) {
+			synctest.Test(test, func(test *testing.T) {
+				runner := newTestRunner(test)
+				workspace := test.TempDir()
+				probeDir := filepath.Join(workspace, location)
+				if err := os.MkdirAll(probeDir, 0o700); err != nil {
+					test.Fatal(err)
+				}
+				first := newProbeTestSession(test, runner, "30a9ebdd-3b6c-441b-8f8e-9569617ab82f", workspace)
+				second := newProbeTestSession(test, runner, "c6b9689a-753c-42f4-a427-6a0df09b6f40", workspace)
+				test.Cleanup(func() {
+					if err := runner.Close(); err != nil {
+						test.Error(err)
+					}
+				})
+				firstProbe := queueTestProbe(test, runner, first)
+				if err := os.WriteFile(filepath.Join(probeDir, firstProbe), []byte("0"), 0o600); err != nil {
+					test.Fatal(err)
+				}
+				probeWritten := make(chan string, 1)
+				releaseWriter := make(chan struct{})
+				probeDone := make(chan error, 1)
+				writer := isolatedControlWriter(func(payload []byte) (int, error) {
+					probeName := regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+					if err := os.WriteFile(filepath.Join(probeDir, probeName), []byte("0"), 0o600); err != nil {
+						return 0, err
+					}
+					probeWritten <- probeName
+					<-releaseWriter
+					return len(payload), nil
+				})
+				go func() { probeDone <- submitTestProbe(runner, second, writer) }()
+				probeName := <-probeWritten
+				if err := runner.DeleteIsolatedSession(first.id); err != nil {
+					test.Error(err)
+				}
+				if _, err := os.Lstat(filepath.Join(probeDir, firstProbe)); !os.IsNotExist(err) {
+					test.Errorf("deleted session's own probe remains: %v", err)
+				}
+				contents, err := os.ReadFile(filepath.Join(probeDir, probeName))
+				if err != nil || string(contents) != "0" {
+					test.Errorf("another session's pending probe changed: %q, %v", contents, err)
+				}
+				close(releaseWriter)
+				if err := <-probeDone; err != nil {
+					test.Errorf("remaining session's preflight: %v", err)
+				}
+			})
+		})
+	}
+}
