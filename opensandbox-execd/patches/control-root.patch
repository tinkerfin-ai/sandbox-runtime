+func TestFailedStartupKeepsPinnedControlRoot(test *testing.T) {
+	runner := newTestRunner(test)
+	workspace := test.TempDir()
+	foreignRoot := test.TempDir()
+	for _, root := range []string{workspace, foreignRoot} {
+		if err := os.WriteFile(filepath.Join(root, ".probe-owned"), []byte(root), 0o600); err != nil {
+			test.Fatal(err)
+		}
+	}
+	startupErr := errors.New("reject startup after workspace replacement")
+	pinnedPath := filepath.Join(test.TempDir(), "pinned")
+	runner.isolator = &lifecycleHarnessIsolator{
+		returnNil: true,
+		wrapErr:   startupErr,
+		configure: func(*exec.Cmd) {
+			if err := os.Rename(workspace, pinnedPath); err != nil {
+				test.Fatal(err)
+			}
+			if err := os.Symlink(foreignRoot, workspace); err != nil {
+				test.Fatal(err)
+			}
+		},
+	}
+	test.Cleanup(func() {
+		if err := runner.Close(); err != nil {
+			test.Error(err)
+		}
+	})
+	_, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		WorkspacePath: workspace,
+		WorkspaceMode: string(isolation.WorkspaceRW),
+	})
+	if !errors.Is(err, startupErr) {
+		test.Fatalf("startup error = %v", err)
+	}
+	contents, err := os.ReadFile(filepath.Join(foreignRoot, ".probe-owned"))
+	if err != nil || string(contents) != foreignRoot {
+		test.Fatalf("failed-start cleanup changed foreign probe: %q, %v", contents, err)
+	}
+	if _, err := os.Lstat(filepath.Join(pinnedPath, ".probe-owned")); !os.IsNotExist(err) {
+		test.Fatalf("failed-start cleanup retained owned probe: %v", err)
+	}
+	if len(runner.ListIsolatedSessions()) != 0 {
+		test.Fatal("failed startup retained session ownership")
+	}
+}
