+func TestBackgroundControlsKeepPinnedRoot(test *testing.T) {
+	for _, mode := range []isolation.WorkspaceMode{isolation.WorkspaceRW, isolation.WorkspaceOverlay} {
+		test.Run(string(mode), func(test *testing.T) {
+			runner := newTestRunner(test)
+			session := &isolatedSession{
+				id: "2395d9e5-b355-4736-9175-b7a7e2025997",
+				opts: &IsolatedSessionOptions{
+					WorkspacePath: test.TempDir(),
+					WorkspaceMode: string(mode),
+				},
+			}
+			rootPath := session.opts.WorkspacePath
+			if mode == isolation.WorkspaceOverlay {
+				var err error
+				session.upperID, session.upperDir, session.workDir, err = runner.upperMgr.Allocate()
+				if err != nil {
+					test.Fatal(err)
+				}
+				rootPath = session.upperDir
+			}
+			openSessionView(test, session)
+			runner.ctrl.isolatedSessionMap.Store(session.id, session)
+			test.Cleanup(func() {
+				if err := runner.Close(); err != nil {
+					test.Error(err)
+				}
+			})
+			foreignRoot := test.TempDir()
+			run := &IsolatedBackgroundRun{ID: "owned-run", SessionID: session.id, running: true}
+			runner.bgRuns.Store(run.ID, run)
+			for _, root := range []string{rootPath, foreignRoot} {
+				if err := os.MkdirAll(filepath.Join(root, isolatedBackgroundRunDir), 0o700); err != nil {
+					test.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(root, run.relLogPath()), []byte(root), 0o600); err != nil {
+					test.Fatal(err)
+				}
+				code := "17"
+				if root == foreignRoot {
+					code = "99"
+				}
+				if err := os.WriteFile(filepath.Join(root, run.relExitPath()), []byte(code), 0o600); err != nil {
+					test.Fatal(err)
+				}
+			}
+			pinnedPath := filepath.Join(test.TempDir(), "pinned")
+			if err := os.Rename(rootPath, pinnedPath); err != nil {
+				test.Fatal(err)
+			}
+			if err := os.Symlink(foreignRoot, rootPath); err != nil {
+				test.Fatal(err)
+			}
+			paths, err := session.backgroundRunPaths()
+			if err != nil {
+				test.Fatal(err)
+			}
+			probeWriter := isolatedControlWriter(func(payload []byte) (int, error) {
+				probeName := regexp.MustCompile("\\.probe-[0-9a-f-]+").FindString(string(payload))
+				if probeName == "" {
+					return 0, fmt.Errorf("probe name missing")
+				}
+				for root, result := range map[string]string{pinnedPath: "0", foreignRoot: "1"} {
+					if err := os.WriteFile(filepath.Join(root, probeName), []byte(result), 0o600); err != nil {
+						return 0, err
+					}
+				}
+				return len(payload), nil
+			})
+			if err := session.beginOperation(); err != nil {
+				test.Fatal(err)
+			}
+			probeErr := runner.preflightBackgroundLogDir(session, probeWriter, paths)
+			session.endOperation()
+			if probeErr != nil {
+				test.Fatal(probeErr)
+			}
+			contents, _, err := runner.SeekIsolatedBackgroundOutput(session.id, run.ID, 0)
+			if err != nil || string(contents) != rootPath {
+				test.Fatalf("pinned log contents = %q, %v", contents, err)
+			}
+			synctest.Test(test, func(test *testing.T) {
+				if err := session.beginOperation(); err != nil {
+					test.Fatal(err)
+				}
+				session.activeBackgroundRuns.Add(1)
+				go runner.watchBackgroundRun(session, run)
+				synctest.Wait()
+				time.Sleep(isolatedBackgroundPollInterval)
+				synctest.Wait()
+				snapshot := run.snapshot()
+				if snapshot.Running || snapshot.ExitCode == nil || *snapshot.ExitCode != 17 {
+					test.Fatalf("pinned completion = %+v", snapshot)
+				}
+				if session.activeBackgroundRuns.Load() != 0 || session.activeOperations != 0 {
+					test.Fatal("completed watcher retained its operation")
+				}
+			})
+			retainedView := session.view
+			if _, err := retainedView.ReadDir("."); err != nil {
+				test.Fatalf("background operation closed the session view: %v", err)
+			}
+			if err := runner.DeleteIsolatedSession(session.id); err != nil {
+				test.Fatal(err)
+			}
+			if _, err := retainedView.ReadDir("."); !errors.Is(err, os.ErrClosed) {
+				test.Fatalf("delete retained the session view: %v", err)
+			}
+			contents, err = os.ReadFile(filepath.Join(foreignRoot, run.relLogPath()))
+			if err != nil || string(contents) != foreignRoot {
+				test.Fatalf("foreign log changed: %q, %v", contents, err)
+			}
+		})
+	}
+}
