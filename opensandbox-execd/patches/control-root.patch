+func TestDeleteSessionKeepsPinnedControlRoot(test *testing.T) {
+	for _, mode := range []isolation.WorkspaceMode{isolation.WorkspaceRW, isolation.WorkspaceOverlay} {
+		test.Run(string(mode), func(test *testing.T) {
+			runner := newTestRunner(test)
+			workspace := filepath.Join(test.TempDir(), "workspace")
+			sessionID, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+				WorkspacePath: workspace,
+				WorkspaceMode: string(mode),
+			})
+			if err != nil {
+				test.Fatal(err)
+			}
+			test.Cleanup(func() {
+				if err := runner.Close(); err != nil {
+					test.Error(err)
+				}
+			})
+			session := runner.lookup(sessionID)
+			rootPath := workspace
+			if mode == isolation.WorkspaceOverlay {
+				rootPath = session.upperDir
+			}
+			foreignRoot := test.TempDir()
+			run := &IsolatedBackgroundRun{ID: "owned-run", SessionID: sessionID}
+			runner.bgRuns.Store(run.ID, run)
+			artifacts := []string{
+				".probe-owned", filepath.Join(isolatedBackgroundRunDir, ".probe-owned"),
+				run.relLogPath(), run.relExitPath(), run.relFallbackLogPath(), run.relFallbackExitPath(),
+			}
+			for _, root := range []string{rootPath, foreignRoot} {
+				if err := os.MkdirAll(filepath.Join(root, isolatedBackgroundRunDir), 0o700); err != nil {
+					test.Fatal(err)
+				}
+				for _, relative := range artifacts {
+					if err := os.WriteFile(filepath.Join(root, relative), []byte(root), 0o600); err != nil {
+						test.Fatal(err)
+					}
+				}
+			}
+			pinnedPath := rootPath + "-pinned"
+			if err := os.Rename(rootPath, pinnedPath); err != nil {
+				test.Fatal(err)
+			}
+			if err := os.Symlink(foreignRoot, rootPath); err != nil {
+				test.Fatal(err)
+			}
+			if err := runner.DeleteIsolatedSession(sessionID); err != nil {
+				test.Fatal(err)
+			}
+			for _, relative := range artifacts {
+				contents, err := os.ReadFile(filepath.Join(foreignRoot, relative))
+				if err != nil || string(contents) != foreignRoot {
+					test.Errorf("foreign control file %q changed: %q, %v", relative, contents, err)
+				}
+				if _, err := os.Lstat(filepath.Join(pinnedPath, relative)); !os.IsNotExist(err) {
+					test.Errorf("owned control file %q remains after deletion: %v", relative, err)
+				}
+			}
+			if _, exists := runner.bgRuns.Load(run.ID); exists {
+				test.Fatal("deleted session retained its background run")
+			}
+		})
+	}
+}
