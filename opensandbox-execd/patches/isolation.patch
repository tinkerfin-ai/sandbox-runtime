+package isolation
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func ownedWorkspaceDescriptors(test *testing.T, roots ...string) []string {
+	test.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	require.NoError(test, err)
+	var descriptors []string
+	for _, entry := range entries {
+		name := filepath.Join("/proc/self/fd", entry.Name())
+		target, err := os.Readlink(name)
+		if os.IsNotExist(err) {
+			continue
+		}
+		require.NoError(test, err)
+		for _, root := range roots {
+			if target == root || strings.HasPrefix(target, root+"/") {
+				descriptors = append(descriptors, name)
+			}
+		}
+	}
+	return descriptors
+}
+
+func TestMergedViewClosesOwnedDescriptors(test *testing.T) {
+	for _, mode := range []WorkspaceMode{WorkspaceRW, WorkspaceRO, WorkspaceOverlay} {
+		test.Run(string(mode), func(test *testing.T) {
+			fixture := newMergedViewFixture(test, mode)
+			writeFixtureFile(test, fixture.lower, "file.txt", "data")
+			_, err := fixture.view.ReadFile("file.txt")
+			require.NoError(test, err)
+			_, err = fixture.view.ReadDir(".")
+			require.NoError(test, err)
+			expectedRoots := 1
+			if mode == WorkspaceOverlay {
+				expectedRoots = 2
+			}
+			require.Len(test, ownedWorkspaceDescriptors(test, filepath.Dir(fixture.lower)), expectedRoots)
+			require.NoError(test, fixture.view.Close())
+			require.NoError(test, fixture.view.Close())
+			require.Empty(test, ownedWorkspaceDescriptors(test, filepath.Dir(fixture.lower)))
+		})
+	}
+}
+
+func TestMergedViewFailedConstructorClosesOwnedDescriptors(test *testing.T) {
+	base := test.TempDir()
+	lower := filepath.Join(base, "lower")
+	require.NoError(test, os.Mkdir(lower, 0o755))
+	for _, upper := range []string{filepath.Join(base, "missing"), lower} {
+		view, err := NewMergedView(lower, upper, WorkspaceOverlay, uint32(os.Getuid()), uint32(os.Getgid()))
+		require.Error(test, err)
+		require.Nil(test, view)
+		require.Empty(test, ownedWorkspaceDescriptors(test, base))
+	}
+}
+
+func TestMergedViewFailedUploadClosesOwnedFile(test *testing.T) {
+	fixture := newMergedViewFixture(test, WorkspaceRW)
+	_, err := fixture.view.WriteFileReader("file.txt", failingContentReader{err: os.ErrPermission}, 0o600)
+	require.ErrorIs(test, err, os.ErrPermission)
+	require.Len(test, ownedWorkspaceDescriptors(test, filepath.Dir(fixture.lower)), 1)
+	require.NoError(test, fixture.view.Close())
+	require.Empty(test, ownedWorkspaceDescriptors(test, filepath.Dir(fixture.lower)))
+}
+
+func TestMergedViewCreatedParentsBelongToSession(test *testing.T) {
+	if os.Geteuid() != 0 {
+		test.Skip("ownership integration requires root")
+	}
+	for _, operation := range []string{"write", "mkdir", "rename", "copy up", "whiteout"} {
+		test.Run(operation, func(test *testing.T) {
+			mode := WorkspaceRW
+			if operation == "copy up" || operation == "whiteout" {
+				mode = WorkspaceOverlay
+			}
+			fixture := newMergedViewFixture(test, mode)
+			fixture.view.uid, fixture.view.gid = 1000, 1000
+			root := fixture.lower
+			if mode == WorkspaceOverlay {
+				root = fixture.upper
+			}
+			switch operation {
+			case "write":
+				require.NoError(test, fixture.view.WriteFile("parent/child/file", []byte("data"), 0o644))
+			case "mkdir":
+				require.NoError(test, fixture.view.MkdirAll("parent/child", 0o755))
+			case "rename":
+				require.NoError(test, fixture.view.WriteFile("file", []byte("data"), 0o644))
+				require.NoError(test, fixture.view.Rename("file", "parent/child/file"))
+			case "copy up", "whiteout":
+				writeFixtureFile(test, fixture.lower, "parent/child/file", "data")
+				if operation == "copy up" {
+					require.NoError(test, fixture.view.Chmod("parent/child/file", 0o600))
+				} else {
+					require.NoError(test, fixture.view.Remove("parent/child/file"))
+				}
+			}
+			for _, name := range []string{"parent", "parent/child"} {
+				info, err := os.Stat(filepath.Join(root, name))
+				require.NoError(test, err)
+				ownership := info.Sys().(*syscall.Stat_t)
+				require.EqualValues(test, 1000, ownership.Uid, name)
+				require.EqualValues(test, 1000, ownership.Gid, name)
+			}
+		})
+	}
+}
