diff --git a/components/execd/pkg/runtime/isolated_control_cleanup_test.go b/components/execd/pkg/runtime/isolated_control_cleanup_test.go
new file mode 100644
index 0000000..2bb7cc8
--- /dev/null
+++ b/components/execd/pkg/runtime/isolated_control_cleanup_test.go
@@ -0,0 +1,142 @@
+//go:build !windows
+
+package runtime
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"github.com/alibaba/opensandbox/execd/pkg/isolation"
+)
+
+func TestDeleteSessionWithUntrustedControlDirectory(test *testing.T) {
+	for _, controlPath := range []string{".execd", isolatedBackgroundRunDir} {
+		test.Run(controlPath, func(test *testing.T) {
+			runner := newTestRunner(test)
+			workspace := test.TempDir()
+			if err := os.MkdirAll(filepath.Dir(filepath.Join(workspace, controlPath)), 0o700); err != nil {
+				test.Fatal(err)
+			}
+			if err := syscall.Mkfifo(filepath.Join(workspace, controlPath), 0o600); err != nil {
+				test.Fatal(err)
+			}
+			session := &isolatedSession{
+				id: "fe203bb3-775c-461d-a405-456470864935",
+				opts: &IsolatedSessionOptions{
+					WorkspacePath: workspace,
+					WorkspaceMode: string(isolation.WorkspaceRW),
+				},
+			}
+			runner.sessionIDs = map[string]struct{}{session.id: {}}
+			runner.ctrl.isolatedSessionMap.Store(session.id, session)
+
+			if err := runner.DeleteIsolatedSession(session.id); err != nil {
+				test.Fatal(err)
+			}
+			if runner.lookup(session.id) != nil {
+				test.Fatal("completed cleanup retained session ownership")
+			}
+			if err := runner.DeleteIsolatedSession(session.id); err != nil {
+				test.Fatalf("repeated delete: %v", err)
+			}
+			if err := os.RemoveAll(workspace); err != nil {
+				test.Fatalf("stopped workspace cannot be deleted: %v", err)
+			}
+		})
+	}
+}
+
+func TestIsolatedControlFilesRejectSpecialFiles(test *testing.T) {
+	workspace := test.TempDir()
+	root, err := os.OpenRoot(workspace)
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer root.Close()
+	if err := syscall.Mkfifo(filepath.Join(workspace, "fifo"), 0o600); err != nil {
+		test.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(workspace, "directory"), 0o700); err != nil {
+		test.Fatal(err)
+	}
+	for _, name := range []string{"fifo", "directory"} {
+		test.Run(name, func(test *testing.T) {
+			for _, flag := range []int{os.O_RDONLY, os.O_WRONLY} {
+				file, err := openIsolatedControlFile(root, name, flag)
+				if file != nil {
+					_ = file.Close()
+				}
+				if err == nil {
+					test.Fatal("special control file was accepted")
+				}
+			}
+			if _, ready := readIsolatedControlFile(root, name, 64); ready {
+				test.Fatal("special control file reported ready")
+			}
+			capIsolatedRunLog(root, name)
+		})
+	}
+	devices, err := os.OpenRoot("/dev")
+	if err != nil {
+		test.Fatal(err)
+	}
+	defer devices.Close()
+	if file, err := openIsolatedControlFile(devices, "null", os.O_RDONLY); err == nil {
+		_ = file.Close()
+		test.Fatal("device was accepted as a control file")
+	}
+}
+
+func TestDeleteSessionConvergesAfterUpperGC(test *testing.T) {
+	runner := newTestRunner(test)
+	upperID, upperDir, workDir, err := runner.upperMgr.Allocate()
+	if err != nil {
+		test.Fatal(err)
+	}
+	session := &isolatedSession{
+		id: "39047796-e5c8-4322-a41a-87c6b3ab6876",
+		opts: &IsolatedSessionOptions{
+			WorkspacePath: test.TempDir(),
+			WorkspaceMode: string(isolation.WorkspaceOverlay),
+		},
+		upperID:  upperID,
+		upperDir: upperDir,
+		workDir:  workDir,
+	}
+	runner.sessionIDs = map[string]struct{}{session.id: {}}
+	runner.ctrl.isolatedSessionMap.Store(session.id, session)
+	upperRoot := runner.upperMgr.Root()
+	parkedRoot := filepath.Join(test.TempDir(), "parked-upper")
+	if err := os.Rename(upperRoot, parkedRoot); err != nil {
+		test.Fatal(err)
+	}
+	if err := os.WriteFile(upperRoot, nil, 0o600); err != nil {
+		test.Fatal(err)
+	}
+	if err := runner.DeleteIsolatedSession(session.id); err == nil {
+		test.Fatal("upper removal unexpectedly succeeded with a non-directory parent")
+	}
+	if runner.lookup(session.id) != session || !session.cleanupFailed.Load() {
+		test.Fatal("failed upper removal lost cleanup ownership")
+	}
+	if err := os.Remove(upperRoot); err != nil {
