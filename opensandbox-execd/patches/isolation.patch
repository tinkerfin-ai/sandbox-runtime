+	}
+	if err := os.Rename(parkedRoot, upperRoot); err != nil {
+		test.Fatal(err)
+	}
+	if err := runner.collectReleasedUppers(); err != nil {
+		test.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Dir(upperDir)); !os.IsNotExist(err) {
+		test.Fatalf("GC did not remove the released upper: %v", err)
+	}
+	if err := runner.DeleteIsolatedSession(session.id); err != nil {
+		test.Fatalf("delete after successful upper GC: %v", err)
+	}
+	if runner.lookup(session.id) != nil {
