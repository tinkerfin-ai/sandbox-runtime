diff --git a/components/execd/pkg/runtime/isolated_session_ownership_test.go b/components/execd/pkg/runtime/isolated_session_ownership_test.go
new file mode 100644
index 0000000..b4b9be3
--- /dev/null
+++ b/components/execd/pkg/runtime/isolated_session_ownership_test.go
@@ -0,0 +1,184 @@
+//go:build !windows
+
+package runtime
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/alibaba/opensandbox/execd/pkg/isolation"
+)
+
+const ownedSessionID = "de4b0067-1b35-42f7-8b65-5d214060c165"
+
+func TestDeclaredSessionCancellationPreventsLateCreate(t *testing.T) {
+	runner := newTestRunner(t)
+	workspace := filepath.Join(t.TempDir(), "uncreated")
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+	_, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID:        ownedSessionID,
+		SessionNamespace: runner.sessionNamespace,
+		WorkspacePath:    workspace,
+		WorkspaceMode:    "rw",
+	})
+	if !errors.Is(err, ErrSessionIDConflict) {
+		t.Fatalf("late create: %v", err)
+	}
+	if _, err := os.Stat(workspace); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("create had side effects: %v", err)
+	}
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDeclaredSessionCapacityRetainsCancellation(t *testing.T) {
+	runner := newTestRunner(t)
+	runner.sessionIDLimit = 1
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+	otherID := "de4b0067-1b35-42f7-8b65-5d214060c166"
+	if err := runner.DeleteIsolatedSession(otherID); err != nil {
+		t.Fatalf("new cancellation: %v", err)
+	}
+	if len(runner.sessionIDs) != 1 {
+		t.Fatalf("full ledger grew: %d", len(runner.sessionIDs))
+	}
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+	_, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID: ownedSessionID, SessionNamespace: runner.sessionNamespace,
+		WorkspacePath: t.TempDir(), WorkspaceMode: "rw",
+	})
+	if !errors.Is(err, ErrSessionIDConflict) {
+		t.Fatalf("retired identifier: %v", err)
+	}
+	workspace := filepath.Join(t.TempDir(), "uncreated")
+	_, err = runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID: otherID, SessionNamespace: runner.sessionNamespace,
+		WorkspacePath: workspace, WorkspaceMode: "rw",
+	})
+	if !errors.Is(err, ErrSessionIDCapacity) {
+		t.Fatalf("new identifier: %v", err)
+	}
+	if _, err := os.Stat(workspace); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("capacity rejection had side effects: %v", err)
+	}
+	if err := runner.DeleteIsolatedSession(otherID); err != nil {
+		t.Fatalf("repeated cancellation: %v", err)
+	}
+}
+
+type blockedCreationLifecycle struct {
+	*stubWorkloadLifecycle
+	entered chan struct{}
+}
+
+func (lifecycle *blockedCreationLifecycle) WaitForIdentity(ctx context.Context) (isolation.WorkloadIdentity, error) {
+	close(lifecycle.entered)
+	<-ctx.Done()
+	return isolation.WorkloadIdentity{}, ctx.Err()
+}
+
+func TestDeclaredSessionStartingIsQueryableAndCancellable(t *testing.T) {
+	runner := newTestRunner(t)
+	lifecycle := &blockedCreationLifecycle{stubWorkloadLifecycle: newStubWorkloadLifecycle(), entered: make(chan struct{})}
+	runner.isolator = &lifecycleHarnessIsolator{lifecycle: lifecycle}
+	createResult := make(chan error, 1)
+	workspace := t.TempDir()
+	go func() {
+		_, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+			SessionID: ownedSessionID, SessionNamespace: runner.sessionNamespace,
+			WorkspacePath: workspace, WorkspaceMode: "rw",
+		})
+		createResult <- err
+	}()
+	<-lifecycle.entered
+	state, err := runner.GetIsolatedSession(ownedSessionID)
+	if err != nil || state.Status != SessionStatusStarting || state.WorkspacePath != workspace {
+		t.Fatalf("starting session: %+v, %v", state, err)
+	}
+	listed := runner.ListIsolatedSessions()
+	if len(listed) != 1 || listed[0].WorkspacePath != workspace {
+		t.Fatalf("owned list: %+v", listed)
+	}
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-createResult; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled create: %v", err)
+	}
+	if _, err := runner.GetIsolatedSession(ownedSessionID); !errors.Is(err, ErrContextNotFound) {
+		t.Fatalf("deleted record: %v", err)
+	}
+}
+
+func TestDeclaredSessionRejectsPreviousDaemon(t *testing.T) {
+	runner := newTestRunner(t)
+	_, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID: ownedSessionID, SessionNamespace: "previous-instance",
+		WorkspacePath: t.TempDir(), WorkspaceMode: "rw",
+	})
+	if !errors.Is(err, ErrSessionNamespaceConflict) {
+		t.Fatalf("previous instance: %v", err)
+	}
+	if len(runner.ListIsolatedSessions()) != 0 {
+		t.Fatal("previous instance admitted work")
+	}
+}
+
+type retryTerminationLifecycle struct {
+	*stubWorkloadLifecycle
+	terminationErr error
+}
+
+func (lifecycle *retryTerminationLifecycle) Terminate(ctx context.Context) error {
+	if lifecycle.terminationErr != nil {
+		return lifecycle.terminationErr
+	}
+	return lifecycle.stubWorkloadLifecycle.Terminate(ctx)
+}
+
+func TestDeclaredSessionFailedTerminationRetainsRootsAndOwnership(t *testing.T) {
+	runner := newTestRunner(t)
+	lifecycle := &retryTerminationLifecycle{stubWorkloadLifecycle: newStubWorkloadLifecycle(), terminationErr: context.Canceled}
+	runner.isolator = &lifecycleHarnessIsolator{lifecycle: lifecycle}
+	t.Cleanup(func() {
+		lifecycle.terminationErr = nil
+		if err := runner.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	identity, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID: ownedSessionID, SessionNamespace: runner.sessionNamespace,
+		WorkspacePath: t.TempDir(), WorkspaceMode: "rw",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	owned := runner.lookup(identity)
+	if err := runner.DeleteIsolatedSession(identity); !errors.Is(err, ErrSessionTerminationUnconfirmed) {
+		t.Fatalf("delete: %v", err)
+	}
+	if runner.lookup(identity) != owned || owned.view == nil {
+		t.Fatal("failed termination lost ownership")
+	}
+	state, err := runner.GetIsolatedSession(identity)
+	if err != nil || state.Status != SessionStatusCleanupFailed {
+		t.Fatalf("failed state: %+v, %v", state, err)
+	}
+	lifecycle.terminationErr = nil
+	if err := runner.DeleteIsolatedSession(identity); err != nil {
+		t.Fatal(err)
+	}
+	if owned.view != nil {
+		t.Fatal("successful delete retained filesystem roots")
+	}
+}
