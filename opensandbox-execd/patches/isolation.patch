index 0000000..93ae720
--- /dev/null
+++ b/components/execd/pkg/runtime/isolated_session_cancel_linux_integration_test.go
@@ -0,0 +1,91 @@
+//go:build linux && bwrap
+
+package runtime
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/alibaba/opensandbox/execd/pkg/isolation"
+)
+
+func TestDeclaredSessionCancelBeforeNativeReady(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("namespace lifecycle integration requires root")
+	}
+	config := isolation.Config{UpperRoot: t.TempDir(), UpperMaxBytes: 1 << 30}
+	isolator := isolation.NewBwrap(config)
+	if !isolator.Available() {
+		t.Fatal("native isolation is required for this integration")
+	}
+	runner, err := NewIsolatedRunner(NewController("", ""), isolator, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := runner.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	identityReady := make(chan isolation.WorkloadIdentity, 1)
+	pinNamespaces := runner.namespacePinner
+	runner.namespacePinner = func(ctx context.Context, identity isolation.WorkloadIdentity) (sessionNamespacePins, error) {
+		pins, err := pinNamespaces(ctx, identity)
+		if err != nil {
+			return pins, err
+		}
+		identityReady <- identity
+		<-ctx.Done()
+		return pins, ctx.Err()
+	}
+	privateNetwork := false
+	userID := uint32(1000)
+	options := &IsolatedSessionOptions{
+		SessionID: ownedSessionID, SessionNamespace: runner.sessionNamespace,
+		WorkspacePath: t.TempDir(), WorkspaceMode: "rw", Profile: "strict",
+		ShareNet: &privateNetwork, Uid: &userID, Gid: &userID, UidMode: "setpriv",
+	}
+	creationDone := make(chan error, 1)
+	go func() { _, err := runner.CreateIsolatedSession(context.Background(), options); creationDone <- err }()
+	var identity isolation.WorkloadIdentity
+	select {
+	case identity = <-identityReady:
+	case err := <-creationDone:
+		t.Fatalf("create ended before native readiness: %v", err)
+	}
+	state, err := runner.GetIsolatedSession(ownedSessionID)
+	if err != nil || state.Status != SessionStatusStarting {
+		t.Fatalf("starting state: %+v, %v", state, err)
+	}
+	var processes []unix.PollFd
+	for _, pid := range []int{identity.SandboxPID, identity.PID} {
+		descriptor, err := unix.PidfdOpen(pid, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer unix.Close(descriptor)
+		processes = append(processes, unix.PollFd{Fd: int32(descriptor), Events: unix.POLLIN})
+	}
+	if count, err := unix.Poll(processes, 0); err != nil || count != 0 {
+		t.Fatalf("workload exited before deletion: %d, %v", count, err)
+	}
+	if err := runner.DeleteIsolatedSession(ownedSessionID); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-creationDone; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancelled create: %v", err)
+	}
+	if count, err := unix.Poll(processes, 0); err != nil || count != len(processes) {
+		t.Fatalf("delete did not confirm native process exits: %d, %v", count, err)
+	}
+	if _, err := runner.GetIsolatedSession(ownedSessionID); !errors.Is(err, ErrContextNotFound) {
+		t.Fatalf("deleted session: %v", err)
+	}
+	if _, err := runner.CreateIsolatedSession(context.Background(), options); !errors.Is(err, ErrSessionIDConflict) {
+		t.Fatalf("late create: %v", err)
+	}
+}
