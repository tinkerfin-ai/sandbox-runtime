new file mode 100644
index 0000000..5e3bc26
--- /dev/null
+++ b/components/execd/pkg/isolation/termination_linux.go
@@ -0,0 +1,192 @@
+//go:build linux
+
+package isolation
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+func (l *bwrapLifecycle) TrackProcess(pid int) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.monitorFD != nil {
+		return errors.New("bwrap monitor is already tracked")
+	}
+	l.monitorPID = pid
+	descriptor, err := unix.PidfdOpen(pid, 0)
+	if err != nil {
+		return fmt.Errorf("pin bwrap monitor: %w", err)
+	}
+	l.monitorFD = os.NewFile(uintptr(descriptor), "bwrap-monitor")
+	return nil
+}
+
+func (l *bwrapLifecycle) pinSandbox(status bwrapSandboxStatus) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.sandboxFD != nil || l.sandboxExited {
+		return nil
+	}
+	if status.pidNamespaceID == 0 {
+		return errors.New("bwrap did not report a private PID namespace")
+	}
+	if l.monitorFD == nil {
+		return errors.New("bwrap monitor identity is unavailable")
+	}
+	processRoot, err := os.OpenRoot(filepath.Join("/proc", strconv.Itoa(status.pid)))
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			descriptor, pinErr := unix.PidfdOpen(status.pid, 0)
+			if errors.Is(pinErr, unix.ESRCH) {
+				l.sandboxExited = true
+				return nil
+			}
+			if pinErr == nil {
+				_ = unix.Close(descriptor)
+			}
+		}
+		return fmt.Errorf("open namespace init identity: %w", err)
+	}
+	defer processRoot.Close()
+	descriptor, err := unix.PidfdOpen(status.pid, 0)
+	if err != nil {
+		return fmt.Errorf("pin namespace init: %w", err)
+	}
+	processFile := os.NewFile(uintptr(descriptor), "bwrap-namespace-init")
+	valid := false
+	defer func() {
+		if !valid {
+			_ = processFile.Close()
+		}
+	}()
+	identity, err := processRoot.ReadFile("status")
+	if err != nil {
+		return fmt.Errorf("read pinned namespace init identity: %w", err)
+	}
+	parentMatches, namespaceInit := false, false
+	for _, line := range strings.Split(string(identity), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "PPid:" {
+			parentMatches = fields[1] == strconv.Itoa(l.monitorPID)
+		}
+		if len(fields) > 2 && fields[0] == "NSpid:" {
+			namespaceInit = fields[len(fields)-1] == "1"
+		}
+	}
+	if !parentMatches || !namespaceInit {
+		return errors.New("bwrap child is not the monitor's private namespace init")
+	}
+	pidNamespace, err := processRoot.Readlink("ns/pid")
+	if err != nil || pidNamespace != fmt.Sprintf("pid:[%d]", status.pidNamespaceID) {
+		return errors.Join(errors.New("bwrap child PID namespace does not match its status"), err)
+	}
+	exited, err := pidfdExited(int(l.monitorFD.Fd()))
+	if err != nil || exited {
+		return errors.Join(errors.New("bwrap monitor exited before namespace init was pinned"), err)
+	}
+	l.sandboxFD = processFile
+	valid = true
+	return nil
+}
+
+func (l *bwrapLifecycle) Terminate(ctx context.Context) error {
+	l.Abort()
+	l.mu.Lock()
+	started := l.monitorPID != 0
+	l.mu.Unlock()
+	if !started {
+		return nil
+	}
+	select {
+	case <-l.sandboxKnown:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	l.mu.Lock()
+	status := l.sandboxResult
+	l.mu.Unlock()
+	if status.err != nil {
+		return fmt.Errorf("namespace init identity is unconfirmed: %w", status.err)
+	}
+	if err := l.pinSandbox(status); err != nil {
+		return err
+	}
+	l.mu.Lock()
+	if l.sandboxExited {
+		l.mu.Unlock()
+		return nil
+	}
+	descriptor := int(l.sandboxFD.Fd())
+	l.mu.Unlock()
+	if err := unix.PidfdSendSignal(descriptor, unix.SIGKILL, nil, 0); err != nil && !errors.Is(err, unix.ESRCH) {
+		return fmt.Errorf("kill namespace init: %w", err)
+	}
+	if err := waitPIDFD(ctx, descriptor); err != nil {
+		return fmt.Errorf("wait for namespace termination: %w", err)
+	}
+	return nil
+}
+
+func pidfdExited(descriptor int) (bool, error) {
+	pollDescriptors := []unix.PollFd{{Fd: int32(descriptor), Events: unix.POLLIN}}
+	_, err := unix.Poll(pollDescriptors, 0)
+	if err != nil {
+		return false, err
+	}
+	if pollDescriptors[0].Revents&(unix.POLLERR|unix.POLLNVAL) != 0 {
+		return false, errors.New("namespace process descriptor is invalid")
+	}
+	return pollDescriptors[0].Revents&(unix.POLLIN|unix.POLLHUP) != 0, nil
+}
+
+func waitPIDFD(ctx context.Context, descriptor int) error {
+	cancelPipe := make([]int, 2)
+	if err := unix.Pipe2(cancelPipe, unix.O_CLOEXEC|unix.O_NONBLOCK); err != nil {
+		return err
+	}
+	defer unix.Close(cancelPipe[0])
+	defer unix.Close(cancelPipe[1])
+	stopWatcher, watcherDone := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(watcherDone)
+		select {
+		case <-ctx.Done():
+			_, _ = unix.Write(cancelPipe[1], []byte{1})
+		case <-stopWatcher:
+		}
+	}()
+	defer func() {
+		close(stopWatcher)
+		<-watcherDone
+	}()
+	pollDescriptors := []unix.PollFd{
+		{Fd: int32(descriptor), Events: unix.POLLIN},
+		{Fd: int32(cancelPipe[0]), Events: unix.POLLIN},
+	}
+	for {
+		_, err := unix.Poll(pollDescriptors, -1)
+		if errors.Is(err, unix.EINTR) {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if pollDescriptors[0].Revents&(unix.POLLERR|unix.POLLNVAL) != 0 {
+			return errors.New("namespace process descriptor is invalid")
+		}
+		if pollDescriptors[0].Revents&(unix.POLLIN|unix.POLLHUP) != 0 {
+			return nil
+		}
+		if pollDescriptors[1].Revents != 0 {
+			return ctx.Err()
+		}
+	}
+}
