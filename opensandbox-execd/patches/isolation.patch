@@ -0,0 +1,113 @@
+//go:build linux
+
+package isolation
+
+import (
+	"context"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestNamespaceExitHelper(t *testing.T) {
+	if os.Getenv("EXECD_TERMINATION_TEST_HELPER") != "1" {
+		return
+	}
+	_, _ = io.Copy(io.Discard, os.Stdin)
+}
+
+func blockedPIDFDProcess(t *testing.T) (*exec.Cmd, int, *os.File) {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = reader.Close(); _ = writer.Close() })
+	command := exec.Command(os.Args[0], "-test.run=^TestNamespaceExitHelper$")
+	command.Env = append(os.Environ(), "EXECD_TERMINATION_TEST_HELPER=1")
+	command.Stdin = reader
+	if err := command.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = command.Process.Kill(); _ = command.Wait() })
+	_ = reader.Close()
+	descriptor, err := unix.PidfdOpen(command.Process.Pid, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = unix.Close(descriptor)
+	})
+	return command, descriptor, writer
+}
+
+func TestNamespaceExitWaitUsesProcessNotification(t *testing.T) {
+	_, descriptor, release := blockedPIDFDProcess(t)
+	if exited, err := pidfdExited(descriptor); err != nil || exited {
+		t.Fatalf("blocked process exited: %v, %v", exited, err)
+	}
+	if err := release.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := waitPIDFD(context.Background(), descriptor); err != nil {
+		t.Fatal(err)
+	}
+	if exited, err := pidfdExited(descriptor); err != nil || !exited {
+		t.Fatalf("exit was not confirmed: %v, %v", exited, err)
+	}
+}
+
+func TestNamespaceExitWaitCancellationRetainsProcess(t *testing.T) {
+	_, descriptor, _ := blockedPIDFDProcess(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := waitPIDFD(ctx, descriptor); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel: %v", err)
+	}
+	if exited, err := pidfdExited(descriptor); err != nil || exited {
+		t.Fatalf("cancellation changed process: %v, %v", exited, err)
+	}
+}
+
+func TestNamespaceExitRejectsInvalidDescriptor(t *testing.T) {
+	if err := waitPIDFD(context.Background(), 1<<30); err == nil {
+		t.Fatal("invalid descriptor confirmed exit")
+	}
+}
+
+func TestNamespaceAbortPreservesSetupUntilClose(t *testing.T) {
+	statusReader, statusWriter, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer statusReader.Close()
+	defer statusWriter.Close()
+	setupReader, setupWriter, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer setupWriter.Close()
+	defer setupReader.Close()
+	parent, child, inode, err := newGateSocketpair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer child.Close()
+	lifecycle := newBwrapLifecycle(statusReader, setupWriter, parent, int(child.Fd()), inode, false)
+	defer lifecycle.Close()
+	lifecycle.Abort()
+	pollDescriptors := []unix.PollFd{{Fd: int32(setupReader.Fd()), Events: unix.POLLIN}}
+	if count, err := unix.Poll(pollDescriptors, 0); err != nil || count != 0 {
+		t.Fatalf("abort released setup before identity: %d, %v", count, err)
+	}
+	if err := lifecycle.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if count, err := unix.Poll(pollDescriptors, 0); err != nil || count != 1 || pollDescriptors[0].Revents&unix.POLLHUP == 0 {
+		t.Fatalf("close retained setup descriptor: %d, %v", count, err)
+	}
+}
