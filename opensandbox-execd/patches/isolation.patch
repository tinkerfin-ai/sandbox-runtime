+
+func TestPrivateDevicesAfterRootBind(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("private device integration requires root")
+	}
+	base := t.TempDir()
+	root := filepath.Join(base, "minimal-root")
+	workspace := filepath.Join(base, "workspace")
+	if err := os.Mkdir(workspace, 0o777); err != nil {
+		t.Fatal(err)
+	}
+	binds := []isolation.BindMount{{Source: root, Dest: "/", ReadOnly: true}}
+	for _, path := range []string{"/usr", "/bin", "/lib", "/lib64"} {
+		if _, err := os.Stat(path); os.IsNotExist(err) {
+			continue
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		binds = append(binds, isolation.BindMount{Source: path, Dest: path, ReadOnly: true})
+	}
+	binds = append(binds,
+		isolation.BindMount{Source: workspace, Dest: workspace},
+		isolation.BindMount{Source: "/dev/null", Dest: "/dev/null", ReadOnly: true},
+	)
+	for _, path := range []string{"/proc", "/dev/shm", "/dev/pts", "/usr", "/bin", "/lib", "/lib64", workspace} {
+		if err := os.MkdirAll(filepath.Join(root, strings.TrimPrefix(path, "/")), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(root, "dev", "null"), nil, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	allowedPaths := make([]string, 0, len(binds))
+	for _, binding := range binds {
+		allowedPaths = append(allowedPaths, binding.Source)
+	}
+	config := isolation.Config{UpperRoot: base, UpperMaxBytes: 1 << 30, AllowedWritable: allowedPaths}
+	isolator := isolation.NewBwrap(config)
+	if !isolator.Available() {
+		t.Fatal("native isolation is required for this integration")
+	}
+	runner, err := NewIsolatedRunner(NewController("", ""), isolator, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := runner.Close(); err != nil {
+			t.Error(err)
+		}
+	})
+	var hostDevices []uint64
+	for _, path := range []string{"/dev", "/dev/shm", "/dev/pts"} {
+		info, err := os.Stat(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hostDevices = append(hostDevices, uint64(info.Sys().(*syscall.Stat_t).Dev))
+	}
+	userID := uint32(1000)
+	privateNetwork := false
+	sessionID, err := runner.CreateIsolatedSession(context.Background(), &IsolatedSessionOptions{
+		SessionID: ownedSessionID, SessionNamespace: runner.sessionNamespace,
+		WorkspacePath: workspace, WorkspaceMode: "rw", Profile: "strict",
+		ShareNet: &privateNetwork, Uid: &userID, Gid: &userID, UidMode: "setpriv",
+		EnvPassthroughMode: "allow", EnvPassthroughKeys: []string{"PATH"}, Binds: binds,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	program := fmt.Sprintf(`
+import os
+import stat
+import subprocess
+import sys
+assert os.geteuid() == 1000 and os.getegid() == 1000
+assert stat.S_ISCHR(os.stat('/dev/null').st_mode)
+descriptor = os.open('/dev/null', os.O_RDWR)
+assert os.write(descriptor, b'input') == 5
+assert os.read(descriptor, 1) == b''
+os.close(descriptor)
+subprocess.run([sys.executable, '-I', '-S', '-c', 'pass'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
+assert stat.S_IMODE(os.stat('/dev/shm').st_mode) == 0o1777
+with open('/dev/shm/session-data', 'xb') as output:
+    output.write(b'private')
+assert open('/dev/shm/session-data', 'rb').read() == b'private'
+master, slave = os.openpty()
+assert os.ttyname(slave).startswith('/dev/pts/')
+assert os.fstat(slave).st_uid == 1000
+os.close(master)
+os.close(slave)
+for path, device in zip(('/dev', '/dev/shm', '/dev/pts'), (%d, %d, %d)):
+    assert os.stat(path).st_dev != device, path
+print('private-devices-ready')
+`, hostDevices[0], hostDevices[1], hostDevices[2])
+	var output strings.Builder
+	err = runner.RunInIsolatedSession(context.Background(), sessionID, "python3 -I -S -c "+shellescape(program), nil,
+		func(line string) { output.WriteString(line); output.WriteByte('\n') })
+	if err != nil || !strings.Contains(output.String(), "private-devices-ready") {
+		t.Fatalf("private device command: %v\n%s", err, output.String())
+	}
+	if err := runner.DeleteIsolatedSession(sessionID); err != nil {
+		t.Fatal(err)
+	}
+}
